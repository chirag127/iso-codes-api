{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/iso-codes/data/schema.json",
  "title": "ISO Country/Currency/Language Codes",
  "description": "ISO 3166-1 (country), ISO 4217 (currency), ISO 639 (language) codes",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      }
    }
  }
}
